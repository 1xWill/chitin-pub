# Secrets / credentials only.

# Base RPC endpoint used by the backend to read/verify onchain data.
# This often includes an API key -> treat as secret.
BASE_RPC_URL=

# Relayer EOA private key (Base ETH required) used by /api/tip to pay gas
RELAYER_PRIVATE_KEY=

# Postgres connection string for the CHITIN backend
DATABASE_URL=

# Protect cron endpoints (reconcile + refresh-balances).
# Required in production.
CRON_TOKEN=

# Contract deployment (Hardhat)
DEPLOYER_PRIVATE_KEY=
